    "notes": {
        "excluded": [
            "sillytavern-transformers — ONNX runtime, requires native C++ bindings not available on iOS",
            "open — opens system browser, not applicable on iOS",
            "simple-git — uses child_process internally, not available in nodejs-mobile sandbox",
            "webpack — build tool only, not needed at runtime",
            "bowser — browser detection frontend lib, not needed server-side",
            "dompurify — frontend-only lib",
            "fuse.js — frontend-only lib",
            "highlight.js — frontend-only lib",
            "localforage — frontend-only lib",
            "morphdom — frontend-only lib",
