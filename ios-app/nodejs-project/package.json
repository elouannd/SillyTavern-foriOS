            "slidetoggle — frontend-only lib",
            "@adobe/css-tools — frontend-only lib",
            "@iconfu/svg-inject — frontend-only lib",
            "@popperjs/core — frontend-only lib",
            "diff-match-patch — frontend-only lib (kept in case server uses it)",
            "droll — frontend dice rolling lib"
        ]
    }
